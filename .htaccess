# Apache Server Configuration for SEO & Performance Optimization
# Copy this to .htaccess in your root directory

# ═══════════════════════════════════════════════════════════════════════════
# 1. Enable GZIP Compression
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 2. Enable Browser Caching
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache images for 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Cache CSS and JavaScript for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Cache fonts for 1 year
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  
  # Cache HTML for 1 week
  ExpiresByType text/html "access plus 1 week"
  
  # Default cache time
  ExpiresDefault "access plus 2 days"
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 3. Proper Cache Control Headers
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_headers.c>
  # Enable CORS for fonts
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache images
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000"
    Header set Expires "Thu, 31 Dec 2099 23:59:59 GMT"
  </FilesMatch>
  
  # Cache CSS and JS
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>
  
  # Don't cache HTML
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 4. HTTPS Redirect
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remove www if present
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  
  # Or add www if not present (choose one)
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 5. Disable Directory Listing
# ═══════════════════════════════════════════════════════════════════════════

Options -Indexes

# ═══════════════════════════════════════════════════════════════════════════
# 6. Block Access to Sensitive Files
# ═══════════════════════════════════════════════════════════════════════════

<FilesMatch "\.(env|json|lock|sql|yaml|yml|config)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to hidden files and directories
<FilesMatch "^\." >
  Order allow,deny
  Deny from all
</FilesMatch>

# ═══════════════════════════════════════════════════════════════════════════
# 7. Robots.txt and Sitemap Caching
# ═══════════════════════════════════════════════════════════════════════════

<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# ═══════════════════════════════════════════════════════════════════════════
# 8. Fix 404 Errors for Single Page Application
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # If the requested file or directory does not exist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite to index.html
  RewriteRule ^.*$ index.html [L]
</IfModule>
